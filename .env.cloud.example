# SERVER ONLY. Never use VITE_ prefixes or commit real values.
# Supabase Connect > Session pooler, port 5432. URL-encode the database password.
# Use the schema owner account. This deployment uses one server instance.
DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?schema=restaurantos&sslmode=require&connection_limit=5&pool_timeout=20"
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY="REPLACE_WITH_SERVER_SECRET_KEY"
SUPABASE_STORAGE_BUCKET="restaurantos-products"
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
# Set only behind Render's reverse proxy. Leave unset when serving directly.
TRUST_PROXY_HOPS=1
# Online TEST restaurant, including simulated receipts, never real fiscalization.
DEMO_MODE=1
DEMO_PASSWORD="REPLACE_WITH_UNIQUE_PASSWORD_MINIMUM_16_CHARACTERS"
SEED_ON_START=1
