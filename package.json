{
  "name": "restaurant-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "demo": "node scripts/demo.mjs",
    "test:demo": "node scripts/demo.mjs --test",
    "api": "tsx --env-file-if-exists=.env server/main.ts",
    "build": "tsc --noEmit && vite build",
    "db:setup": "prisma migrate deploy && prisma generate",
    "seed": "tsx --env-file-if-exists=.env server/seed.ts",
    "test": "tsx --env-file-if-exists=.env --test tests/flow.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/client": "6.19.3",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.4.0",
    "prisma": "6.19.3",
    "tsx": "^4.19.0",
    "typescript": "~5.8.0",
    "vite": "^6.4.0"
  }
}
